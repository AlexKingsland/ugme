# Copy to .env for local development (`shopify app dev` fills in the Shopify values).
# Never commit .env.

# Postgres — a free Neon database works well for dev: https://neon.tech
# (or local Postgres: postgresql://postgres:postgres@localhost:5432/socialwall)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Cloudflare R2 (a dev bucket, separate from production)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
MEDIA_PUBLIC_BASE_URL=https://media.cloverkitstudio.com

# Email (Resend). Leave RESEND_API_KEY empty to write previews to .email-previews/
RESEND_API_KEY=
EMAIL_FROM=

# Optional
# TEST_SUBMITTERS=your-dev-store.myshopify.com:you@example.com
# ORDER_RETENTION_DAYS=60     (sales analytics: order records kept; daily totals forever)
# FALLBACK_UPLOAD_MAX_MB=50
# FALLBACK_UPLOAD_CONCURRENCY=2
# BILLING_TEST=true          (production only: use test charges)
# COUNT_TEST_ORDERS=true     (production only: count test orders in analytics)
# RECHARGE_API_TOKEN=        (legacy subscription rewards; unused by Social Wall)
