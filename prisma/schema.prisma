generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

// Shopify session storage (required by @shopify/shopify-app-session-storage-prisma)
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// ─── UGME Models ───────────────────────────────────────────────

enum SubscriptionProvider {
  RECHARGE
  SHOPIFY_NATIVE
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAUSED
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

enum ContentType {
  PHOTO
  VIDEO
}

enum DiscountType {
  FREE
  FIXED_AMOUNT
  PERCENTAGE
}

enum RewardType {
  NONE                  // just being featured on the wall
  DISCOUNT_CODE
  STORE_CREDIT
  SUBSCRIPTION_DISCOUNT // legacy — no longer offered for new wall campaigns
}

enum BillingFrequency {
  DAY
  WEEK
  MONTH
}

enum StorageTier {
  TIER_10GB
  TIER_100GB
  TIER_1TB
}

enum PlanTier {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum RewardStatus {
  CREATED
  APPLIED
  FAILED
}

enum EmailType {
  MAGIC_LINK
  SUBMISSION_RECEIVED
  SUBMISSION_APPROVED
  SUBMISSION_REJECTED
  CAMPAIGN_INVITE
}

model Shop {
  id                   String               @id @default(cuid())
  shopDomain           String               @unique
  accessToken          String
  subscriptionProvider SubscriptionProvider  @default(SHOPIFY_NATIVE)
  providerApiKey       String?              // encrypted API key for ReCharge etc
  providerConnected    Boolean              @default(false)
  providerConfig       String               @default("{}") // JSON stored as string for SQLite
  defaultRewardCycles  Int                  @default(1)
  storageTier          StorageTier          @default(TIER_10GB)
  planTier             PlanTier             @default(FREE)
  shopifySubscriptionId String?             // Shopify recurring charge ID
  planActivatedAt      DateTime?
  brandName            String?
  logoUrl              String?
  pixelActivatedAt     DateTime?            // checkout pixel turned on by the app once; if it's gone later, the merchant removed it
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  campaigns            Campaign[]
  customers            Customer[]
  rechargeCustomers    RechargeCustomer[]
}

model Campaign {
  id               String         @id @default(cuid())
  shopId           String
  title            String
  status           CampaignStatus @default(DRAFT)
  moment           String         // The creative/contextual ask
  productId        String?        // Shopify product GID
  productTitle     String?        // Product name for display
  productImageUrl  String?        // Product image URL for hero display
  // Wall campaign products: who counts as a verified buyer
  productScope     String         @default("SPECIFIC") // "SPECIFIC" | "ALL"
  products         String         @default("[]") // JSON [{ id, title, handle, imageUrl }]
  contentType      ContentType      @default(VIDEO)
  captureSpecs     String         @default("[]") // JSON array of spec objects
  rewardType       RewardType     @default(DISCOUNT_CODE)
  // Subscription discount fields
  rewardCycles     Int            @default(1)
  rewardFrequency  BillingFrequency @default(MONTH)
  discountType     DiscountType   @default(FREE)
  discountValue    Float          @default(0)
  // Discount code fields
  discountCodeAmount    Float?         // e.g. 20 (for 20% or $20)
  discountCodeType      String?        // "PERCENTAGE" or "FIXED_AMOUNT"
  discountCodeExpiryDays Int?          // e.g. 30 days from approval
  discountCodeMinOrder  Float?         // minimum order amount to use code
  // Store credit fields
  storeCreditAmount     Float?
  storeCreditExpiryDays Int?
  startDate        DateTime?
  endDate          DateTime?
  maxSubmissions   Int?
  rightsAcknowledgedAt DateTime?  // merchant accepted the usage rights agreement
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  shop             Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  submissions      Submission[]

  @@index([shopId])
  @@index([status])
}

model Customer {
  id                  String             @id @default(cuid())
  shopId              String
  email               String
  shopifyCustomerId   String?
  subscriptionId      String?
  subscriptionStatus  SubscriptionStatus @default(ACTIVE)
  magicLinkToken      String?
  magicLinkExpiresAt  DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  shop                Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  submissions         Submission[]
  rewards             Reward[]
  emailLogs           EmailLog[]

  @@unique([shopId, email])
  @@index([shopId])
  @@index([magicLinkToken])
}

model Submission {
  id            String           @id @default(cuid())
  campaignId    String
  customerId    String
  status        SubmissionStatus @default(PENDING)
  contentType   ContentType      @default(PHOTO)
  contentUrl    String
  thumbnailUrl  String?
  fileBytes     Int            @default(0)
  durationSecs  Int?
  description   String?
  subscriptionId String?          // Recharge (or other provider) subscription ID tied to this submission
  products      String         @default("[]") // JSON [{ id, title, handle, imageUrl }] — wall products this verified buyer purchased (product cards)
  displayName   String?        // "Sam K." — only set when the customer opted in to showing their name
  markedUsed    Boolean        @default(false)
  usageTags     String         @default("[]")
  rightsAccepted Boolean       @default(false)
  rejectionReason String?
  reviewedAt    DateTime?
  reviewNote    String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  campaign      Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer      Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reward        Reward?

  @@index([campaignId])
  @@index([customerId])
  @@index([status])
}

model Reward {
  id                 String               @id @default(cuid())
  submissionId       String               @unique
  customerId         String
  rewardType         RewardType       @default(DISCOUNT_CODE)
  cycles             Int              @default(1)
  discountProvider   String?          // "RECHARGE" or "SHOPIFY_NATIVE" for subscription rewards
  externalDiscountId String?
  rechargeChargeId   String?
  rechargeSubscriptionId String?
  discountCode       String?
  storeCreditAmount  Float?           // store credit rewards: amount credited
  appliedAt          DateTime?
  expiresAt          DateTime?        // discount-code rewards: when the code stops working
  status             RewardStatus         @default(CREATED)
  failureReason      String?          // why the last fulfilment attempt failed (internal — not shown to customers)
  attemptCount       Int              @default(0)
  lastAttemptAt      DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  submission         Submission           @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  customer           Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model RechargeCustomer {
  id                    String   @id @default(cuid())
  shopId                String
  shopifyCustomerId     String
  rechargeCustomerId    String
  rechargeSubscriptionId String?
  subscriptionStatus    SubscriptionStatus @default(ACTIVE)
  nextChargeDate        DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  shop                  Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, shopifyCustomerId])
  @@index([shopId])
  @@index([rechargeCustomerId])
}

model EmailLog {
  id          String    @id @default(cuid())
  customerId  String
  type        EmailType
  sentAt      DateTime  @default(now())
  metadata    String    @default("{}") // JSON stored as string for SQLite

  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

// ── Sales attribution ────────────────────────────────────────────
// Every order is recorded (for "% of store revenue"); lines the wall drove are
// recorded in WallOrderLine. Money is integer cents in the shop's currency,
// excluding shipping and tax, after discounts.
model WallOrder {
  id             String          @id @default(cuid())
  shopId         String
  orderId        String          // numeric Shopify order id
  orderName      String?
  orderedAt      DateTime
  day            String          @default("") // YYYY-MM-DD in the shop's time zone (rollup key)
  currency       String
  revenueCents   Int             // subtotal after discounts
  refundedCents  Int             @default(0)
  test           Boolean         @default(false)
  counted        Boolean         @default(true) // included in the rollups (test orders aren't, in production)
  linesJson      String          @default("[]") // every product line, for credit that arrives later (checkout pixel)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  lines          WallOrderLine[]

  @@unique([shopId, orderId])
  @@index([shopId, orderedAt])
  @@index([orderedAt])
}

model WallOrderLine {
  id             String          @id @default(cuid())
  orderRefId     String
  lineItemId     String
  productId      String          // numeric Shopify product id
  productTitle   String?
  kind           AttributionKind
  campaignId     String?         // wall campaign (kept even if the wall is deleted later)
  submissionId   String?         // post that drove it
  quantity       Int
  revenueCents   Int
  refundedCents  Int             @default(0)

  order          WallOrder       @relation(fields: [orderRefId], references: [id], onDelete: Cascade)

  @@unique([orderRefId, lineItemId])
  @@index([campaignId])
  @@index([submissionId])
}

// Dashboard rollups — the reports read these, never the orders (one row per shop per day)
model WallDailyStat {
  id               String   @id @default(cuid())
  shopId           String
  day              String   // YYYY-MM-DD, shop time zone
  currency         String
  totalCents       Int      @default(0) // store revenue, net of refunds
  directCents      Int      @default(0)
  influencedCents  Int      @default(0)
  directOrders     Int      @default(0)
  influencedOrders Int      @default(0)

  @@unique([shopId, day])
}

// One row per post per day it earned anything (top posts / top walls)
model WallPostDailyStat {
  id               String   @id @default(cuid())
  shopId           String
  day              String
  submissionId     String
  campaignId       String?
  directCents      Int      @default(0)
  influencedCents  Int      @default(0)

  @@unique([shopId, day, submissionId])
  @@index([shopId, day])
}

// Views reported by the checkout web pixel ("Buy it now" skips the cart attribute)
model WallPixelView {
  id             String          @id @default(cuid())
  shopId         String
  orderId        String
  seen           String          // "<productId>:<submissionId>:<unixSecs>,…"
  createdAt      DateTime        @default(now())

  @@unique([shopId, orderId])
}

model WallRefund {
  id             String          @id @default(cuid())
  shopId         String
  refundId       String
  createdAt      DateTime        @default(now())

  @@unique([shopId, refundId])
}

enum AttributionKind {
  DIRECT     // added to cart from the wall's product card
  INFLUENCED // product of a post the shopper watched in the last 7 days
}
